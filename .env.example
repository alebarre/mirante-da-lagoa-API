# Ambiente de desenvolvimento local
# Copie este arquivo para .env e preencha os valores
# Nunca commite o arquivo .env real

# Banco de dados PostgreSQL (subido via Docker Compose nesta pasta)
DB_NAME=mirante_lagoa
DB_USER=mirante
DB_PASS=mirante123
DB_PORT=5433

# JDBC URL (padrao aponta para o Docker Compose local)
DB_URL=jdbc:postgresql://localhost:5433/mirante_lagoa

# JWT - gere uma chave forte: openssl rand -base64 64
JWT_SECRET=substitua_por_chave_base64_gerada

# SMTP (opcional, necessario apenas para recuperacao de senha)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# CORS e porta da API
CORS_ORIGINS=http://localhost:4200
SERVER_PORT=8080
